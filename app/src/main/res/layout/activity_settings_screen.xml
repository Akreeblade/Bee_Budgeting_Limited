<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundTint="#CA1A1A"
    tools:context=".SettingsScreen">

    <!-- 1. MAIN CONTENT WINDOW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CardView must wrap something, or use layout_height="0dp" with weights -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Horizontal layout holding your buttons and image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#72502D"
            android:foregroundTint="#E91212"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="100dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:text="@string/backbutton"
                android:textAlignment="center"
                android:textColor="#FDBB14" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="232dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/nsettings"
                android:textAlignment="center"
                android:textColor="#000000" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0"
                app:srcCompat="@drawable/house" />

        </LinearLayout>

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/account_information"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:text="@string/recurring_payments"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/budget_goals"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/app_themes"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- 2. OPTIONAL DRAWER MENU (If you want a side menu, it goes here with android:layout_gravity="start") -->

</androidx.drawerlayout.widget.DrawerLayout>
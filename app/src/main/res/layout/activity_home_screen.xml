<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rotation="0"
    android:rotationX="0"
    android:rotationY="0"
    tools:context=".HomeScreen"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#f6f6e4">

            <!-- CardView must wrap something, or use layout_height="0dp" with weights -->

            <!-- Horizontal layout holding your buttons and image -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/ProfileBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3"
                    android:backgroundTint="@color/Bright_yellow"
                    android:text="Button 1" />

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0"
                    app:srcCompat="@drawable/house" />

                <ImageButton
                    android:id="@+id/Settingsbtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/cogicon" />

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:layout_gravity="fill_horizontal"
            android:layout_marginTop="65dp">

            <ProgressBar
                android:id="@+id/progressBar2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:max="100"
                android:progress="75"
                android:progressBackgroundTint="@color/Gray_brown"


                android:progressTint="@color/Bright_yellow"
                android:scaleY="5"
                tools:visibility="visible" />

            <androidx.cardview.widget.CardView
                android:id="@+id/overviewArea"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardBackgroundColor="@color/Deep_brown"
                app:cardCornerRadius="25dp">

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/Homebtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#725030"
                    app:srcCompat="@drawable/houseicon" />

                <ImageButton
                    android:id="@+id/Barrybtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#725030"
                    app:srcCompat="@drawable/bearicon" />

                <ImageButton
                    android:id="@+id/Analyticsbtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#725030"
                    app:srcCompat="@drawable/analyticsicon" />

            </LinearLayout>

            <Button
                android:id="@+id/Addbtn"
                android:layout_width="73dp"
                android:layout_height="78dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="0dp"


                android:backgroundTint="@color/Bright_yellow"
                android:text="+"
                android:textColor="@color/Deep_brown"
                android:textColorLink="#f2c560"
                android:textSize="40dp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</androidx.drawerlayout.widget.DrawerLayout>
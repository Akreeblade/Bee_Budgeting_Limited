<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6E4"
    tools:context=".HomeScreen">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F6E4">

        <!-- ========================= -->
        <!-- TOP BAR -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/ProfileBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/profileicon" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/Settingsbtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/cogicon" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- OVERVIEW CARD -->
        <!-- ========================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/overviewArea"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/Dark_brown"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- PERIOD -->
                <TextView
                    android:id="@+id/tvPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="1 August - 12 August 2026"
                    android:textColor="@color/Bright_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#8A4D1A"
                    android:alpha="0.7" />

                <!-- INCOME -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvIncomeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Income"
                        android:textColor="@color/Bright_yellow"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIncomeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R1200"
                        android:textColor="#EFFF4A"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#8A4D1A"
                    android:alpha="0.7" />

                <!-- EXPENSES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvExpensesLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses"
                        android:textColor="#FF9638"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExpensesTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R550"
                        android:textColor="#FF8A25"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#8A4D1A"
                    android:alpha="0.7" />

                <!-- BALANCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBalanceLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Balance"
                        android:textColor="@color/Bright_yellow"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBalanceTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R650"
                        android:textColor="#FFB817"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ========================= -->
        <!-- MONTHLY BUDGET -->
        <!-- ========================= -->

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBarBudget"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="37"
            app:indicatorColor="@color/Bright_yellow"
            app:trackColor="@color/Gray_brown"
            app:trackCornerRadius="18dp"
            app:trackThickness="35dp"
            app:layout_constraintTop_toBottomOf="@id/overviewArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvBudgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Monthly Budget"
            android:textColor="@color/Dark_brown"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/progressBarBudget"
            app:layout_constraintTop_toTopOf="@id/progressBarBudget"
            app:layout_constraintBottom_toBottomOf="@id/progressBarBudget" />

        <TextView
            android:id="@+id/tvBudgetAmounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="R550 / R1500"
            android:textColor="@color/Dark_brown"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/progressBarBudget"
            app:layout_constraintTop_toTopOf="@id/progressBarBudget"
            app:layout_constraintBottom_toBottomOf="@id/progressBarBudget" />


        <!-- ========================= -->
        <!-- HISTORY TITLE & VIEW ALL -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="History"
            android:textColor="@color/Dark_brown"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/progressBarBudget"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvViewAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="View all"
            android:textColor="@color/Dark_brown"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvHistoryLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvHistoryLabel" />


        <!-- ========================= -->
        <!-- TRANSACTION HISTORY -->
        <!-- ========================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactionHistory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryLabel"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_transaction" />


        <!-- ========================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ========================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:background="#725030"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- HOME -->
            <ImageButton
                android:id="@+id/Homebtn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/houseicon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/Barrybtn" />

            <!-- BARRY -->
            <ImageButton
                android:id="@+id/Barrybtn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/bearicon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/Homebtn"
                app:layout_constraintEnd_toStartOf="@id/Analyticsbtn" />

            <!-- ANALYTICS -->
            <ImageButton
                android:id="@+id/Analyticsbtn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/analyticsicon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/Barrybtn"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ADD BUTTON -->
            <Button
                android:id="@+id/Addbtn"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:backgroundTint="@color/Bright_yellow"
                android:text="+"
                android:textColor="@color/Dark_brown"
                android:textSize="36sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/Barrybtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:translationY="31dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>